# ==============================================================================
# FinTrack Frontend - Environment Configuration
# ==============================================================================

# Data Source Mode: 'api' (Default authoritative REST backend) or 'local' (offline fallback)
VITE_DATA_SOURCE=api

# Backend API Base URL
# In development: http://localhost:5001/api
# In production:
#   Option A (Same origin / reverse proxy): Leave blank or unset — client defaults to relative '/api'
#   Option B (Independent API subdomain): https://api.fintrack.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:5001/api
