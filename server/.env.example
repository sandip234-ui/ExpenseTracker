# ==============================================================================
# FinTrack Server - Environment Configuration
# ==============================================================================

# Server Network Port
PORT=5001

# Runtime Environment ('development' | 'production' | 'test')
# In 'production', missing JWT_SECRET or weak secrets will immediately halt startup.
NODE_ENV=production

# Client Origin (CORS Policy)
# In production, specify the exact domain(s) of your frontend deployment.
# Supports single origin or comma-separated list of origins.
# Examples:
#   CLIENT_ORIGIN=https://fintrack.yourdomain.com
#   CLIENT_ORIGIN=https://app.fintrack.com,https://staging.fintrack.com
CLIENT_ORIGIN="http://localhost:5173"

# Authoritative PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Ensure connection pooling params (?connection_limit=10) are appended for production.
DATABASE_URL="postgresql://fintrack_user:strong_password@localhost:5432/fintrack_prod?schema=public&sslmode=prefer"

# JWT Authentication Secrets
# MANDATORY in production: Must be at least 32 characters of high-entropy randomness.
# Generate via: openssl rand -base64 32
JWT_SECRET="replace-with-at-least-32-characters-of-random-entropy-in-production"

# Token Expiration Duration (e.g., '1h', '24h', '7d')
JWT_EXPIRES_IN="7d"
